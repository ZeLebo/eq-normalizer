{
  "manifest_version": 3,
  "name": "eq-normalizer",
  "version": "0.2.0",
  "description": "Выравнивает громкость диалогов и громких сцен в фильмах. Обработка звука только на устройстве.",
  "browser_specific_settings": {
    "gecko": {
      "id": "night-leveler@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "eq-normalizer", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["page-audio.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["audio/worklet.js", "audio/dsp.js", "audio/settings.js"], "matches": ["http://*/*", "https://*/*"] }
  ]
}
